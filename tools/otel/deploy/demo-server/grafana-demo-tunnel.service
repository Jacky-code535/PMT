[Unit]
Description=Persistent reverse SSH tunnel to failure-telemetry Demo server
Wants=network-online.target
After=network-online.target grafana-server.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT \
  -i /root/.ssh/failure-telemetry-demo \
  -p 2522 \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -R 127.0.0.1:13000:127.0.0.1:3000 \
  root@10.112.227.52
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
