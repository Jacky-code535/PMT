# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Collect Intel PMT GNR FIVR Health snapshot
ConditionPathIsDirectory=/sys/class/intel_pmt

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/collect_fivr_health.sh
User=root
Group=root
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/sys/class/intel_pmt
ReadWritePaths=/var/lib/intel-pmt
